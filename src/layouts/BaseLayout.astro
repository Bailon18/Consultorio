---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Umbrales | Psicología y psicoterapia en San Isidro, Lima",
  description = "Umbrales: espacio de psicoterapia clínica en San Isidro, Lima. Un espacio para detenerse, comprender y atravesar lo que cambia. Atención presencial y virtual.",
} = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "Psychologist",
  name: "Umbrales — Lic. Carmen Valenzuela Avalos",
  alternateName: "Carmen Valenzuela",
  description: "Espacio de psicoterapia clínica en San Isidro, Lima. Psicología y psicoterapia presencial y virtual.",
  url: "https://www.umbralespsicoterapia.com/",
  image: "https://www.umbralespsicoterapia.com/images/umbrales-logo-hero.png",
  telephone: "+51927477800",
  email: "hola@umbralespsicoterapia.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Av. Pezet 1449",
    addressLocality: "San Isidro",
    addressRegion: "Lima",
    addressCountry: "PE",
  },
  areaServed: ["San Isidro", "Miraflores", "Surco", "La Molina", "Lima"],
};
